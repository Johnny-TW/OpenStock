# === QAS 測試環境 ===
# 資料庫
DB_USER=postgres
DB_PASSWORD=your-qas-db-password
DB_NAME=stocksmart_qas

# JWT（前後端必須一致）
JWT_SECRET=your-qas-jwt-secret

# 後端
ANTHROPIC_API_KEY=your-anthropic-api-key

# 前端
NEXT_PUBLIC_API_HOST=http://your-qas-server:3004
NEXTAUTH_URL=http://your-qas-server:3000
NEXTAUTH_SECRET=your-qas-nextauth-secret

# Azure AD
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=your-azure-tenant-id
