# 資料庫連線
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/stocksmart?schema=public

# JWT（前後端必須一致）
JWT_SECRET=your-jwt-secret-here

# Anthropic API（AI 分析）
ANTHROPIC_API_KEY=your-anthropic-api-key

# 伺服器 port
PORT=3004

# Langfuse LLM 可觀測性（未設定時自動停用，不影響分析功能）
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_BASEURL=https://cloud.langfuse.com  # EU 區；US 用 us.cloud.langfuse.com；日本用 jp.cloud.langfuse.com

# 管理員 email（逗號分隔），可呼叫 heatmap/save-daily、heatmap/backfill；未設定則無人可呼叫
ADMIN_EMAILS=you@example.com

# 正式 / QAS 預設關閉 Swagger，需要時設為 true
# ENABLE_SWAGGER=true
